[node name="HelpBody" type="Label" parent="HelpModal/Panel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 17
text = "1. Pilih jenis tower di panel kiri bawah (Archer, Ice, Cannon, atau Tesla), lalu klik area rumput di luar jalur monster untuk membangunnya.
2. Tekan tombol Mulai Wave untuk memunculkan gelombang monster dari gua menuju gerbang benteng.
3. Kalahkan monster untuk mendapatkan koin. Klik tower yang sudah berdiri untuk meningkatkan Damage (+Damage), Jangkauan (+Jangkauan), atau menjualnya.
4. Cegah monster mencapai gerbang benteng agar Nyawa tidak habis. Setiap kelipatan 5 wave akan muncul Boss Troll!"
autowrap_mode = 3

